/* ==========================================================================
   TOKNERS DESIGN SYSTEM & STYLESHEET
   Accurately matches Figma specifications (1920px grid, Azo Sans metrics)
   ========================================================================== */

/* --- CSS Variables & Design Tokens --- */
:root {
  --color-bg-light: #f7f5f9;
  --color-bg-card: #f2f0f4;
  --color-bg-dark: #1d1534;
  --color-card-white: #ffffff;
  
  --color-text-dark: #191b21;
  --color-text-muted: rgba(25, 27, 33, 0.72);
  --color-text-light: #ffffff;
  --color-text-light-muted: rgba(255, 255, 255, 0.75);

  --color-accent-green: #22a75d;
  --color-accent-blue: #2278d4;
  
  --gradient-warm: linear-gradient(135deg, #ed374d 0%, #fa793f 50%, #f7f651 100%);
  --gradient-warm-h: linear-gradient(90deg, #ed374d 0%, #fa793f 50%, #f7f651 100%);
  --gradient-ambient: radial-gradient(circle at 75% 20%, rgba(237, 55, 77, 0.18) 0%, rgba(250, 121, 63, 0.15) 30%, rgba(247, 246, 81, 0.12) 55%, transparent 70%);

  --font-family: 'Outfit', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  
  --radius-pill: 52px;
  --radius-card: 25px;
  
  --container-max-width: 1574px;
  --transition-fast: 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  --transition-smooth: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

/* --- Global Reset & Box Sizing --- */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: 16px;
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  font-family: var(--font-family);
  background-color: var(--color-bg-light);
  color: var(--color-text-dark);
  line-height: 1.5;
  overflow-x: hidden;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

a {
  text-decoration: none;
  color: inherit;
  transition: opacity var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
}

ul {
  list-style: none;
}

button {
  font-family: inherit;
  border: none;
  background: none;
  cursor: pointer;
}

/* --- Container Utility --- */
.container {
  width: 100%;
  max-width: var(--container-max-width);
  margin-left: auto;
  margin-right: auto;
  padding-left: 32px;
  padding-right: 32px;
}

/* ==========================================================================
   HEADER & NAVIGATION
   ========================================================================== */
.site-header {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  padding-top: 36px;
  padding-bottom: 24px;
  transition: background-color var(--transition-fast), box-shadow var(--transition-fast);
}

.site-header.scrolled {
  position: fixed;
  background-color: rgba(247, 245, 249, 0.95);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  padding-top: 18px;
  padding-bottom: 18px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
}

.header-container {
  max-width: 1840px;
  margin: 0 auto;
  padding: 0 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 10;
}

.logo-link {
  display: flex;
  align-items: center;
}

.logo-img {
  width: 220px;
  height: auto;
  display: block;
}

.main-nav {
  display: flex;
  align-items: center;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 36px;
}

.nav-link {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: #ffffff;
  position: relative;
  padding: 6px 0;
  transition: opacity var(--transition-fast);
}

.nav-link:hover {
  opacity: 0.85;
}

.nav-link.active {
  border-bottom: 2px solid #ffffff;
  padding-bottom: 4px;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 28px;
}

.btn-signin {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: #ffffff;
  transition: opacity var(--transition-fast);
}

.btn-signin:hover {
  opacity: 0.85;
}

.btn-signup {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-card-white);
  color: var(--color-text-dark);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  padding: 13px 32px;
  border-radius: var(--radius-pill);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  transition: transform var(--transition-fast), box-shadow var(--transition-fast);
}

.btn-signup:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
}

.mobile-menu-btn {
  display: none;
  flex-direction: column;
  justify-content: space-between;
  width: 26px;
  height: 20px;
  z-index: 101;
}

.mobile-menu-btn span {
  display: block;
  width: 100%;
  height: 2.5px;
  background-color: var(--color-text-dark);
  border-radius: 2px;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

/* ==========================================================================
   HERO SECTION
   ========================================================================== */
.hero-section {
  position: relative;
  padding-top: 180px;
  padding-bottom: 100px;
  overflow: hidden;
  background-color: var(--color-bg-light);
}

/* Multi-layered Orange Fluid Wave Background */
.hero-waves-container {
  position: absolute;
  top: 0;
  right: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}

.hero-wave-layer {
  position: absolute;
  top: 0;
  right: 0;
  pointer-events: none;
}

.hero-wave-layer.layer-3 {
  width: 1146px;
  max-width: 62vw;
  height: auto;
  top: -30px;
  right: 0;
  z-index: 1;
}

.hero-wave-layer.layer-2 {
  width: 1068px;
  max-width: 58vw;
  height: auto;
  top: -60px;
  right: 0;
  z-index: 2;
}

.hero-wave-layer.layer-1 {
  width: 784px;
  max-width: 44vw;
  height: auto;
  top: -20px;
  right: 0;
  z-index: 3;
}

.hero-container {
  position: relative;
  z-index: 4;
  display: grid;
  grid-template-columns: 1.05fr 1.15fr;
  align-items: center;
  gap: 40px;
}

.hero-content {
  max-width: 620px;
}

.hero-tagline {
  display: inline-block;
  font-size: 18px;
  font-weight: 600;
  color: var(--color-accent-blue);
  margin-bottom: 18px;
  letter-spacing: -0.2px;
}

.hero-title {
  font-size: 48px;
  font-weight: 600;
  line-height: 1.16;
  letter-spacing: -0.96px;
  color: var(--color-text-dark);
  margin-bottom: 24px;
}

.hero-desc {
  font-size: 16px;
  font-weight: 300;
  line-height: 1.62;
  color: var(--color-text-muted);
  margin-bottom: 40px;
  max-width: 530px;
}

.hero-cta {
  display: flex;
  align-items: center;
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-accent-green);
  color: var(--color-text-light);
  font-size: 14px;
  font-weight: 700;
  letter-spacing: -0.28px;
  padding: 16px 42px;
  border-radius: var(--radius-pill);
  box-shadow: 0 10px 28px rgba(34, 167, 93, 0.35);
  transition: transform var(--transition-fast), box-shadow var(--transition-fast), background-color var(--transition-fast);
}

.btn-primary:hover {
  transform: translateY(-2px);
  background-color: #1f9954;
  box-shadow: 0 14px 34px rgba(34, 167, 93, 0.45);
}

.hero-visual {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: flex-end;
}

.hero-visual-wrapper {
  position: relative;
  width: 100%;
  max-width: 780px;
  height: 680px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 5;
}

.hero-ground-shadow {
  position: absolute;
  bottom: 10px;
  left: 20%;
  width: 60%;
  height: 28px;
  background: radial-gradient(ellipse at center, rgba(160, 45, 10, 0.35) 0%, rgba(160, 45, 10, 0.12) 50%, transparent 70%);
  filter: blur(8px);
  z-index: 1;
}

.hero-creator-img {
  position: absolute;
  left: 10%;
  bottom: 20px;
  height: 580px;
  width: auto;
  object-fit: contain;
  filter: drop-shadow(0 15px 30px rgba(0, 0, 0, 0.14));
  z-index: 3;
  transition: transform var(--transition-smooth);
}

.hero-guy-img {
  position: absolute;
  right: 14%;
  bottom: 30px;
  height: 610px;
  width: auto;
  object-fit: contain;
  filter: drop-shadow(0 15px 30px rgba(0, 0, 0, 0.12));
  z-index: 2;
  transition: transform var(--transition-smooth);
}

.hero-visual:hover .hero-creator-img {
  transform: translateY(-6px);
}

.hero-visual:hover .hero-guy-img {
  transform: translateY(-4px);
}

/* ==========================================================================
   AUDIENCE CARDS (FOR CREATORS & FOR HODLERS)
   ========================================================================== */
.audience-section {
  padding-top: 50px;
  padding-bottom: 100px;
  position: relative;
  z-index: 2;
  overflow: hidden;
}

.audience-container {
  position: relative;
  z-index: 3;
}

.audience-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32px;
}

.audience-card {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: 50px 40px 0 40px;
  min-height: 840px;
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: transform var(--transition-smooth), box-shadow var(--transition-smooth);
}

.audience-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 24px 50px rgba(0, 0, 0, 0.08);
}

.card-header {
  text-align: center;
  margin-bottom: 20px;
  position: relative;
  z-index: 3;
}

.card-num {
  display: block;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.5px;
  color: rgba(25, 27, 33, 0.5);
  margin-bottom: 12px;
}

.card-title {
  font-size: 36px;
  font-weight: 600;
  letter-spacing: -0.72px;
  color: var(--color-text-dark);
}

.creator-accent {
  color: var(--color-accent-green);
  text-decoration: underline;
  text-underline-offset: 8px;
  text-decoration-thickness: 3px;
}

.hodler-accent {
  color: var(--color-accent-blue);
  text-decoration: underline;
  text-underline-offset: 8px;
  text-decoration-thickness: 3px;
}

.card-text {
  font-size: 16px;
  font-weight: 300;
  line-height: 1.65;
  color: var(--color-text-muted);
  text-align: center;
  max-width: 600px;
  margin: 0 auto 30px auto;
  position: relative;
  z-index: 3;
}

.card-visual {
  margin-top: auto;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  width: 100%;
  z-index: 2;
}

.creator-visual, .hodler-visual {
  height: 480px;
}

.card-art-svg {
  width: 100%;
  max-width: 508px;
  max-height: 480px;
  height: auto;
  object-fit: contain;
  display: block;
  margin: 0 auto;
  transition: transform var(--transition-smooth);
}

.hodler-art {
  max-width: 531px;
}

.audience-card:hover .card-art-svg {
  transform: scale(1.03);
}

/* Surrounding Dark Purple Waves at bottom corners */
.audience-purple-wave {
  position: absolute;
  bottom: -40px;
  left: 0;
  width: 100%;
  line-height: 0;
  z-index: 1;
  pointer-events: none;
}

.purple-wave-img {
  width: 100%;
  height: auto;
  display: block;
}

/* ==========================================================================
   WHAT MAKES US DIFFERENT
   ========================================================================== */
.different-section {
  position: relative;
  background-color: var(--color-bg-dark);
  color: var(--color-text-light);
  margin-top: 60px;
  margin-bottom: 60px;
}

.wave-top, .wave-bottom {
  width: 100%;
  line-height: 0;
  overflow: hidden;
}

.wave-top svg, .wave-bottom svg {
  display: block;
  width: 100%;
  height: 80px;
}

.different-wrapper {
  padding-top: 60px;
  padding-bottom: 80px;
}

.different-container {
  display: grid;
  grid-template-columns: 0.85fr 1.15fr;
  gap: 80px;
  align-items: flex-start;
}

.different-left {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.different-logo-icon {
  margin-bottom: 10px;
}

.different-logo-icon img {
  display: block;
}

.different-title {
  font-size: 48px;
  font-weight: 600;
  line-height: 1.15;
  letter-spacing: -0.96px;
  color: #f7f5f9;
  max-width: 380px;
}

.different-right {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.different-subtitle {
  font-size: 16px;
  font-weight: 600;
  line-height: 1.5;
  color: #ffffff;
}

.different-desc {
  font-size: 16px;
  font-weight: 300;
  line-height: 1.7;
  color: var(--color-text-light-muted);
}

/* ==========================================================================
   ROADMAP SECTION
   ========================================================================== */
.roadmap-section {
  padding-top: 90px;
  padding-bottom: 110px;
  position: relative;
}

.roadmap-container {
  position: relative;
}

.paper-plane-wrapper {
  position: absolute;
  top: -70px;
  right: 40px;
  z-index: 5;
  animation: planeFloat 4s ease-in-out infinite alternate;
}

.paper-plane-img {
  width: 220px;
  height: auto;
  filter: drop-shadow(0 15px 30px rgba(0, 0, 0, 0.08));
}

@keyframes planeFloat {
  0% { transform: translate(0, 0) rotate(0deg); }
  100% { transform: translate(-12px, -16px) rotate(-3deg); }
}

.roadmap-timeline {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
  position: relative;
  padding-top: 20px;
}

.timeline-line {
  position: absolute;
  top: 98px;
  left: 20px;
  right: 20px;
  height: 2px;
  background-color: rgba(25, 27, 33, 0.12);
  z-index: 1;
}

.roadmap-col {
  position: relative;
  display: flex;
  flex-direction: column;
}

.quarter-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24px;
  position: relative;
  z-index: 2;
}

.quarter-tag {
  display: flex;
  flex-direction: column;
}

.q-name {
  font-size: 16px;
  font-weight: 700;
  color: var(--color-accent-green);
  margin-bottom: 4px;
}

.q-year {
  font-size: 36px;
  font-weight: 600;
  letter-spacing: -0.72px;
  color: var(--color-text-dark);
}

.quarter-chevron {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
}

.timeline-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background-color: var(--color-accent-green);
  margin-bottom: 40px;
  position: relative;
  z-index: 2;
  box-shadow: 0 0 0 4px var(--color-bg-light);
}

.quarter-items {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.quarter-items li {
  display: flex;
  align-items: flex-start;
  gap: 14px;
}

.item-num {
  font-size: 12px;
  font-weight: 700;
  color: var(--color-accent-blue);
  line-height: 1.7;
  min-width: 18px;
}

.item-text {
  font-size: 18px;
  font-weight: 400;
  line-height: 1.45;
  color: var(--color-text-dark);
}

/* ==========================================================================
   TOKNERS IS COMING SECTION
   ========================================================================== */
.coming-section {
  padding-top: 100px;
  padding-bottom: 120px;
  background-color: var(--color-bg-card);
  position: relative;
}

.coming-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}

.coming-title {
  font-size: 36px;
  font-weight: 600;
  letter-spacing: -0.72px;
  color: var(--color-text-dark);
  margin-bottom: 32px;
}

.coming-paragraphs {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.coming-paragraphs p {
  font-size: 16px;
  font-weight: 300;
  line-height: 1.7;
  color: var(--color-text-muted);
}

.coming-right {
  display: flex;
  justify-content: center;
}

.coming-card {
  width: 100%;
  max-width: 680px;
  height: 640px;
  background-color: var(--color-bg-light);
  border-radius: var(--radius-card);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.04);
}

.rocket-img {
  position: relative;
  z-index: 2;
  height: 480px;
  width: auto;
  object-fit: contain;
  animation: rocketBob 4s ease-in-out infinite alternate;
}

.cloud-img {
  position: absolute;
  width: 280px;
  height: auto;
  object-fit: contain;
  opacity: 0.95;
  transition: transform var(--transition-smooth);
}

.cloud-top {
  top: 60px;
  right: 40px;
  z-index: 1;
  animation: cloudDrift1 6s ease-in-out infinite alternate;
}

.cloud-bottom {
  bottom: 50px;
  left: 40px;
  z-index: 3;
  animation: cloudDrift2 7s ease-in-out infinite alternate;
}

@keyframes rocketBob {
  0% { transform: translateY(0); }
  100% { transform: translateY(-16px); }
}

@keyframes cloudDrift1 {
  0% { transform: translateX(0); }
  100% { transform: translateX(-15px); }
}

@keyframes cloudDrift2 {
  0% { transform: translateX(0); }
  100% { transform: translateX(18px); }
}

/* ==========================================================================
   PRESALE DETAILS SECTION
   ========================================================================== */
.presale-section {
  position: relative;
  background-color: var(--color-bg-dark);
  color: var(--color-text-light);
  margin-top: 0;
}

.presale-wave-top {
  width: 100%;
  line-height: 0;
  overflow: hidden;
  transform: translateY(-2px);
}

.presale-wave-top svg {
  display: block;
  width: 100%;
  height: 100px;
}

.presale-content-wrapper {
  padding-top: 60px;
  padding-bottom: 100px;
}

.presale-title {
  font-size: 48px;
  font-weight: 600;
  letter-spacing: -0.96px;
  color: #f7f5f9;
  text-align: center;
  margin-bottom: 70px;
}

.presale-cards-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 36px;
  align-items: flex-start;
}

.presale-card {
  background-color: var(--color-card-white);
  border-radius: var(--radius-card);
  padding: 50px 40px;
  min-height: 580px;
  position: relative;
  color: var(--color-text-dark);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform var(--transition-smooth), box-shadow var(--transition-smooth);
}

.card-phase-2.featured-card {
  transform: translateY(30px);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
  border: 2px solid rgba(255, 255, 255, 0.1);
}

.presale-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.3);
}

.card-phase-2.featured-card:hover {
  transform: translateY(22px);
}

/* Outlined Watermark (01, 02, 03) */
.card-watermark {
  position: absolute;
  top: 10px;
  left: 20px;
  font-size: 200px;
  font-weight: 800;
  line-height: 1;
  color: transparent;
  -webkit-text-stroke: 1.5px rgba(25, 27, 33, 0.14);
  pointer-events: none;
  z-index: 1;
  user-select: none;
}

.presale-card-inner {
  position: relative;
  z-index: 2;
}

.phase-heading {
  font-size: 32px;
  font-weight: 600;
  letter-spacing: -0.64px;
  color: var(--color-text-dark);
  margin-bottom: 8px;
}

.phase-date {
  font-size: 16px;
  font-weight: 500;
  color: var(--color-text-dark);
  margin-bottom: 28px;
}

.phase-rate {
  font-size: 20px;
  font-weight: 600;
  color: var(--color-text-dark);
  margin-bottom: 14px;
}

.phase-caps {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.cap-item {
  font-size: 16px;
  font-weight: 400;
  color: var(--color-text-muted);
}

.cap-item strong {
  font-weight: 600;
  color: var(--color-text-dark);
}

.presale-card-visual {
  margin-top: auto;
  position: relative;
  display: flex;
  justify-content: flex-end;
  align-items: flex-end;
  height: 260px;
  z-index: 2;
}

.presale-character-img {
  max-height: 250px;
  width: auto;
  object-fit: contain;
  transition: transform var(--transition-smooth);
}

.presale-duo-img {
  max-height: 250px;
  width: auto;
  object-fit: contain;
  transition: transform var(--transition-smooth);
}

.presale-card:hover .presale-character-img,
.presale-card:hover .presale-duo-img {
  transform: scale(1.05);
}

/* ==========================================================================
   HOW TO BUY SECTION
   ========================================================================== */
.how-to-buy-section {
  background-color: var(--color-bg-dark);
  color: var(--color-text-light);
  padding-top: 60px;
  padding-bottom: 120px;
}

.how-container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.how-title {
  font-size: 36px;
  font-weight: 600;
  letter-spacing: -0.72px;
  color: #f7f5f9;
  text-align: center;
  margin-bottom: 50px;
}

.how-steps-flow {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
  width: 100%;
  max-width: 820px;
}

.how-step-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-pill);
  padding: 22px 36px;
  display: flex;
  align-items: center;
  gap: 24px;
  backdrop-filter: blur(10px);
  transition: background var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
}

.how-step-card:hover {
  background: rgba(255, 255, 255, 0.09);
  border-color: rgba(255, 255, 255, 0.25);
  transform: translateY(-2px);
}

.step-num {
  font-size: 14px;
  font-weight: 700;
  color: var(--color-accent-green);
  background: rgba(34, 167, 93, 0.15);
  padding: 6px 14px;
  border-radius: var(--radius-pill);
}

.step-desc {
  font-size: 16px;
  font-weight: 500;
  line-height: 1.5;
  color: #ffffff;
}

.step-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  animation: bounceArrow 2s infinite ease-in-out;
}

@keyframes bounceArrow {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(6px); }
}

/* ==========================================================================
   FOOTER
   ========================================================================== */
.site-footer {
  background-color: var(--color-bg-dark);
  color: var(--color-text-light);
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  padding-top: 80px;
  padding-bottom: 80px;
}

.footer-container {
  display: flex;
  flex-direction: column;
  gap: 70px;
}

.footer-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28px;
  flex-wrap: wrap;
}

.footer-nav a {
  font-size: 16px;
  font-weight: 700;
  color: #ffffff;
  transition: color var(--transition-fast);
}

.footer-nav a:hover {
  color: var(--color-accent-green);
}

.nav-slash {
  font-size: 16px;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.35);
}

.footer-bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 30px;
}

.footer-logo {
  display: flex;
  align-items: center;
}

.footer-socials {
  display: flex;
  align-items: center;
  gap: 16px;
}

.social-circle {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  border: 2px solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  transition: border-color var(--transition-fast), background-color var(--transition-fast), transform var(--transition-fast);
}

.social-circle:hover {
  border-color: var(--color-accent-green);
  background-color: var(--color-accent-green);
  transform: translateY(-3px);
}

.footer-credits {
  text-align: right;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.copyright-text {
  font-size: 14px;
  font-weight: 400;
  color: #ffffff;
}

.designer-text {
  font-size: 12px;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.6);
}

/* ==========================================================================
   RESPONSIVE DESIGN BREAKPOINTS
   ========================================================================== */
@media (max-width: 1440px) {
  :root {
    --container-max-width: 1280px;
  }
  
  .hero-title {
    font-size: 42px;
  }
  
  .hero-visual-wrapper {
    height: 600px;
  }
  
  .hero-creator-img {
    height: 540px;
  }
  
  .hero-guy-img {
    height: 580px;
  }

  .audience-card {
    min-height: 720px;
  }

  .card-watermark {
    font-size: 160px;
  }
}

@media (max-width: 1200px) {
  .hero-container {
    grid-template-columns: 1fr;
    text-align: center;
    gap: 60px;
  }

  .hero-content {
    max-width: 760px;
    margin: 0 auto;
  }

  .hero-desc {
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta {
    justify-content: center;
  }

  .roadmap-timeline {
    grid-template-columns: repeat(2, 1fr);
    row-gap: 50px;
  }

  .timeline-line {
    display: none;
  }

  .paper-plane-wrapper {
    top: -40px;
    right: 20px;
  }

  .presale-cards-grid {
    grid-template-columns: 1fr;
    gap: 40px;
    max-width: 600px;
    margin: 0 auto;
  }

  .card-phase-2.featured-card {
    transform: none;
  }

  .card-phase-2.featured-card:hover {
    transform: translateY(-6px);
  }

  .coming-container {
    grid-template-columns: 1fr;
    gap: 50px;
  }

  .coming-card {
    height: 500px;
    margin: 0 auto;
  }
}

@media (max-width: 992px) {
  .site-header {
    padding-top: 20px;
  }

  .main-nav {
    position: fixed;
    top: 0;
    right: -100%;
    width: 320px;
    height: 100vh;
    background-color: var(--color-bg-light);
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.1);
    flex-direction: column;
    justify-content: center;
    padding: 60px 40px;
    transition: right var(--transition-smooth);
    z-index: 100;
  }

  .main-nav.active {
    right: 0;
  }

  .nav-links {
    flex-direction: column;
    align-items: flex-start;
    gap: 30px;
    width: 100%;
  }

  .nav-link {
    font-size: 18px;
  }

  .mobile-menu-btn {
    display: flex;
  }

  .audience-grid {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .different-container {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .footer-bottom-row {
    flex-direction: column;
    text-align: center;
    gap: 40px;
  }

  .footer-credits {
    text-align: center;
  }
}

@media (max-width: 768px) {
  .hero-section {
    padding-top: 140px;
    padding-bottom: 80px;
  }

  .hero-title {
    font-size: 34px;
  }

  .hero-visual-wrapper {
    height: 480px;
  }

  .hero-creator-img {
    height: 420px;
    left: 0;
  }

  .hero-guy-img {
    height: 460px;
    right: 0;
  }

  .roadmap-timeline {
    grid-template-columns: 1fr;
  }

  .how-step-card {
    border-radius: 24px;
    padding: 18px 24px;
    flex-direction: column;
    text-align: center;
  }

  .card-watermark {
    font-size: 140px;
  }
}
